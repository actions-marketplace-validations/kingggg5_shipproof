{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kingggg5/shipproof/schemas/external-evidence.schema.json",
  "title": "ShipProof imported external evidence envelope",
  "description": "Opt-in, versioned evidence from another local tool. Imported findings are never rewritten as native ShipProof proof. The default scanner path does not fetch, execute, or refresh the originating tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "verdict",
    "limitations",
    "target_digest",
    "config_digest",
    "captured_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "command": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "verdict": {
      "enum": ["PASS", "PASS_WITH_EVIDENCE", "CONDITIONAL", "WARN", "REVIEW", "BLOCK"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1 }
    },
    "target_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "config_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "captured_at": { "type": "string", "minLength": 10, "maxLength": 64 },
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original_rule_id", "severity", "path", "message"],
        "properties": {
          "original_rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "line": { "type": "integer", "minimum": 1 },
          "message": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
